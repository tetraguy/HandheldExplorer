<Window x:Class="HandheldExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handheld Explorer"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        ManipulationBoundaryFeedback="Window_ManipulationBoundaryFeedback">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Grid view: wrapping tiles. List view: virtualized rows (used automatically for huge folders). -->
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Grid Width="124" Height="138">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Placeholder" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="46"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="72" Height="72" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" MaxHeight="38" FontSize="13" Margin="2,0"/>
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                        Visibility="{Binding IsChecked, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Placeholder" Property="Text" Value="&#xE8B7;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Placeholder" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="24"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" FontSize="15" Margin="6,0"/>
                <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextAlignment="Right"/>
                <Border Grid.Column="4" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                        Visibility="{Binding IsChecked, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Placeholder" Property="Text" Value="&#xE8B7;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="FileItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_LeftUp"/>
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Item_RightUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar entry: quick-access folder, pinned folder or drive (with a usage bar) -->
        <DataTemplate x:Key="NavTemplate">
            <Button Style="{StaticResource NavButton}" Click="Nav_Click" MouseRightButtonUp="Nav_RightUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="DriveDetails" Visibility="Collapsed">
                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,5,0,3"/>
                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDrive}" Value="True">
                    <Setter TargetName="DriveDetails" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============================ main layout ============================ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Width="250" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,12,4">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Explorer" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="8,4,8,8"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" Focusable="False">
                        <StackPanel Margin="8,0">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="QUICK ACCESS"/>
                            <ItemsControl x:Name="QuickList" ItemTemplate="{StaticResource NavTemplate}" Focusable="False"/>
                            <TextBlock x:Name="PinnedHeader" Style="{StaticResource SectionHeader}" Text="PINNED"/>
                            <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource NavTemplate}" Focusable="False"/>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="DRIVES"/>
                            <ItemsControl x:Name="DriveList" ItemTemplate="{StaticResource NavTemplate}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Grid x:Name="TopBar" Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="Show or hide the sidebar"
                            Click="SidebarToggle_Click"/>
                    <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            ToolTip="Back" Click="Back_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up one level"
                            Click="Up_Click"/>
                    <Border Grid.Column="3" Background="{DynamicResource CardBg}" CornerRadius="12" Margin="6,0">
                        <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                                      Focusable="False">
                            <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="4,0"/>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE721;"
                            ToolTip="Filter this folder" Click="Search_Click"/>
                    <Button x:Name="ViewButton" Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                            ToolTip="Switch between grid and list" Click="View_Click"/>
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu"
                            Click="Menu_Click"/>
                </Grid>

                <!-- Files -->
                <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" SelectionMode="Single"
                         ItemContainerStyle="{StaticResource FileItemStyle}"
                         ItemTemplate="{StaticResource TileTemplate}"
                         ItemsPanel="{StaticResource GridPanel}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         IsTextSearchEnabled="False">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="6,0,2,0" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="This folder is empty" FontSize="16"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Status bar + controller hints -->
                <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="PadHints" Grid.Column="1" Orientation="Horizontal" TextElement.FontSize="12">
                            <Border Style="{StaticResource PadBadge}">
                                <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource PadBadge}">
                                <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource PadBadge}">
                                <TextBlock Text="X" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Actions" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource PadBadge}">
                                <TextBlock Text="Y" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Select" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource PadBadge}">
                                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Menu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ overlay (menus, dialogs, keyboard) ============================ -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed" Background="{DynamicResource OverlayDim}"
              MouseLeftButtonDown="Overlay_BackgroundDown"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border x:Name="OverlayCard" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <ContentControl x:Name="OverlayContent" Focusable="False"/>
            </Border>
        </Grid>

        <!-- ============================ toast ============================ -->
        <Border x:Name="Toast" Visibility="Collapsed" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,64" MaxWidth="640"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
